API_DOMAIN=api.farmers.johno.it
API_HOST=0.0.0.0
PORT=8080
SQLITE_PATH=/data/hcommunity.sqlite
CORS_ORIGIN=https://farmers.johno.it
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# Required in production. Choose a unique password of at least 16 characters.
BOOTSTRAP_ADMIN_PASSWORD=
USE_DEMO_DATA=false

# Server-only hosted inference. Never add these to NEXT_PUBLIC_* variables.
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=openrouter
BACKBOARD_MODEL=google/gemma-4-26b-a4b-it

# Enables shared fictional accounts with real hosted AI. At least 8 characters.
# Keep this private and share it only with demo participants.
CAMPUS_DEMO_CODE=

# University-code sign-in stays unavailable until all mail settings are configured.
# Comma-separated exact domains, confirmed by the campus operator.
AUTH_EMAIL_DOMAINS=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
