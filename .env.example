# All settings are public and set at build time. No backend credentials required.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_COMMUNITY_ID=h-farm-prototype
NEXT_PUBLIC_COMMUNITY_NAME=H-FARM
NEXT_PUBLIC_COMMUNITY_LOCATION=Roncade, Treviso
NEXT_PUBLIC_COMMUNITY_TIMEZONE=Europe/Rome

# Set to the HTTPS Node API URL to use a shared backend. Empty = local SQLite demo.
NEXT_PUBLIC_API_URL=
