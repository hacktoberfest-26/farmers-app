{
  "name": "farmers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next dev --webpack --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/prepare-pwa.mjs",
    "predev": "node scripts/prepare-pwa.mjs",
    "api:dev": "tsx watch server/src/main.ts",
    "api:start": "tsx server/src/main.ts",
    "api:backup": "node server/backup.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-intl": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.15.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
